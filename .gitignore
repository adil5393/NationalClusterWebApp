# Runtime-uploaded content (gallery/participant/team photos) lives under
# here and is never committed — but id_card_template.png and the receipt's
# school-logo monogram are versioned design assets the app needs to exist on
# every checkout, so they're carved out.
backend/assets/*
!backend/assets/templates/
!backend/assets/monogram/

frontend/public/images/

# Raw camera originals (8-16MB each) — see frontend/scripts/optimize-school-photos.py.
# The resized WebP output it produces (images-optimized/) is what the app
# actually uses and stays tracked.
frontend/src/assets/images/

scoresheet.pdf
